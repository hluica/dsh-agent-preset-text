{
  "name": "@local/dsh-agent-preset-text",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Take over Agent preset names and descriptions at display time by locale, preset and runtime conditions, without modifying the presets.",
  "license": "MIT",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "rebuild": "node scripts/build.mjs --force",
    "verify": "node scripts/verify.mjs",
    "clean": "node scripts/build.mjs --clean",
    "test": "node test/engine.test.mjs && node test/lifecycle.test.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.2.2-rc.2"
  }
}
